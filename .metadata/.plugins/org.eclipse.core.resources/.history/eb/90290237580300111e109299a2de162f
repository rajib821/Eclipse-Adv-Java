package com.order.serviece.impl;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;

import com.order.OrderRepository;
import com.order.entity.OrderEntity;
import com.order.request.OrderRequest;
import com.order.serviece.IOrderServiece;

@Service
public class OrderServiece implements IOrderServiece {
	@Autowired
	OrderRepository orderRepository;
	@Override
	public void createOrder(OrderRequest orderRequest) {
		OrderEntity entity = new OrderEntity();
		
		entity.setStatus(orderRequest.getStatus());
		entity.setItems(orderRequest.getItems());
		
	}
	
}
