<!DOCTYPE html>
<html>
<head>
    <title>Ola Signup</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background: linear-gradient(to right, #00c853, #b2ff59);
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
        }

        .card {
            background: white;
            padding: 30px;
            width: 320px;
            border-radius: 12px;
            text-align: center;
            box-shadow: 0 8px 16px rgba(0,0,0,0.2);
        }

        h2 {
            color: #2e7d32;
        }

        p {
            color: #555;
        }

        a {
            display: inline-block;
            margin-top: 20px;
            padding: 12px 20px;
            background: #00c853;
            color: white;
            text-decoration: none;
            border-radius: 25px;
            font-weight: bold;
            transition: 0.3s;
        }

        a:hover {
            background: #1b5e20;
            transform: scale(1.05);
        }
    </style>
</head>
<body>

    <div class="card">
        <h2>🚕 Ola Signup</h2>
        <p>Create your Ola account and start riding</p>
        <a href="viewSignup">Signup with Ola</a>
    </div>

</body>
</html>
