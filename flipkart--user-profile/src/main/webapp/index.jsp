<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Flipkart Dashboard</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f5f5f5;
            text-align: center;
            padding-top: 100px;
        }

        h2 {
            color: #ff6f00;
            margin-bottom: 50px;
        }

        a {
            display: inline-block;
            background-color: #0073e6;
            color: white;
            text-decoration: none;
            padding: 15px 30px;
            border-radius: 8px;
            font-size: 18px;
            transition: background-color 0.3s ease;
        }

        a:hover {
            background-color: #005bb5;
        }
    </style>
</head>
<body>
    <h2>Flipkart Dashboard</h2>
    <a href="profile">Profile Creation</a>
</body>
</html>
